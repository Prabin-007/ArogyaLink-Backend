# ============================================================
# ArogyaLink Backend - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control!
# ============================================================

# --- Database ---
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://user:Gopal_khaire@localhost:5432/arogyalink

# --- JWT (JSON Web Token) ---
# Secret key used to sign and verify JWT tokens.
# Use a long, random string in production. Never share this!
JWT_SECRET=your_super_secret_key_here

# How long a JWT token stays valid before expiring.
# Examples: 7d (7 days), 1h (1 hour), 30m (30 minutes)
JWT_EXPIRES_IN=7d

# --- Server ---
# The port the Express server will listen on.
PORT=3001

# --- Development Flags ---
# Set AUTH_ENABLED=false to bypass JWT auth during development.
# All requests will be treated as coming from a dev admin user.
# Set to true in production!
AUTH_ENABLED=false

# Application environment. Use 'production' in prod for security.
# Options: development | production | test
# Application environment. Use 'production' in prod for security.
# Options: development | production | test
NODE_ENV=development

# --- Teleconsultation (Socket.io CORS) ---
# The URL of the frontend web portal.
# Socket.io uses this as the allowed CORS origin for WebSocket connections.
# Must match the URL your React/frontend app runs on.
CLIENT_ORIGIN=http://localhost:5173

# --- Bhashini / ULCA / Dhruva (Speech Translation) ---
# Required only if you want real-time speech translation during teleconsultations.
# Register at https://bhashini.gov.in to obtain these credentials.
#
# Set USE_MOCK_BHASHINI=true (the default) to demo the full video + translation
# UI without real credentials. The backend returns a canned phrase per language
# so the transcript panel updates end-to-end without hitting the Bhashini API.
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_ULCA_KEY=your_bhashini_ulca_api_key
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id
USE_MOCK_BHASHINI=true
